# Preserve generated patch bytes and their recorded SHA256 across Windows checkouts.
# A blank diff context line contains a required space, not a source whitespace error.
docs/patches/*.patch -text -whitespace

# Runtime/model/font assets are binary and must never undergo newline conversion.
*.glb binary
*.blend binary
*.woff2 binary

# Knowledge manifests approve exact bytes, including originals and immutable snapshots.
# Windows checkout conversion must not invalidate those published checksums.
data/cdut/rag/** -text
evaluation/runtime-migration/cases.jsonl -text

# Keep third-party distribution and license bytes intact.
backend/src/campuspilot/web_assets/v2/vendor/gsap-*.min.js -whitespace
