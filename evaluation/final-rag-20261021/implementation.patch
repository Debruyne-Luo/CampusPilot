+        if number in {7, 17, 29, 43}:
+            item["campuses"] = ["all"]
+        elif number in {3, 5, 18, 20, 21, 22, 23, 24, 42}:
+            item["campuses"] = ["chengdu"]
+        if number == 1:
+            item.update(valid_from="2026-08-29", valid_until="2026-08-30")
+        if number == 5:
+            item["valid_until"] = "2026-11-06"
