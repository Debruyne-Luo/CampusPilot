+        aliases="本科生研究生借几本书 借阅上限 数量", kind="limitation",
+        verification_status="official_document", reviewer="Codex-source-review-20261021",
+        verified_at=date(2026, 10, 21), approval_id="CDUT-SOURCE-ADOPTION-20261021",
