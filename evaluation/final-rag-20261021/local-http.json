            ],
            "steps": [
              {
                "mode": "self_service",
                "instruction": "学生卡优先到珙桐食堂校园卡自助服务区；香樟食堂也有自助补卡设备，按机器支持的卡种选择。",
                "condition": "官方2023年通知列出补卡点与当时卡种，2026年指南继续列出服务区；用户2026-10-09确认珙桐、香樟设备。",
                "place_ids": [
                  "cdut:place:gongtong-dining",
                  "cdut:place:camphor-dining",
                  "cdut:place:ginkgo-dining"
                ]
