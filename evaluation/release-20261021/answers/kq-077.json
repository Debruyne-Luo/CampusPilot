sha256=d9b4b7be538b981d38a9e94b9256cf83e6249e7350282b95b65991ad524769ee","revision_id":"3e61c42f626b387f2361fb9a22da6a5008de742c052d9a099a4ad68e3b744752","scope_notes":["仅适用于本科生、研究生","来源适用校区尚未确认"],"source_id":"cdut:source:official:portal-1053","source_url":"https://bsdt.cdut.edu.cn/EIP/nonlogin/elobby/service/introduction/4hjbbewp5kip6nh5r5pstwccmdf4fssg.htm","text_sha256":"6538da2cab4327c3bcbebae3519fa53ecf31e6ab13c6a1fec970f34bbf63a61a"},{"chunk_id":"cdut:chunk:fresh2026:39","content":"砚湖易办“办事指南”公开列出服务目录，可按事项类型、服务对象、办理途径和所属部门筛选。学生相关条目包括新生统一身份认证账号激活说明、砚湖易办使用说明、网络与信息化服务指南（学生版）、网络故障报修、学籍档案查询（毕业生）、学生困难补助、学生综合测评、学历证明、学士学位证明、毕业证书遗失/损坏办理证明书等。具体办理入口、材料和流程以服务详情页为准。","document":"砚湖易办办事指南能查什么","document_id":null,"locator":"砚湖易办办事指南/服务清单","revision_id":null,"scope_notes":["来源适用校区尚未确认"],"source_id":"cdut:source:portal-service-guide","source_url":"https://bsdt.cdut.edu.cn/EIP/nonlogin/serviceGuide/serviceGuideToPage.htm","text_sha256":"a6bd7e5345f49c179ddb1804e3dfdcaaa20076eb0daf4801a957844129fb7779"}],"map_actions":[],"places":[],"plan":[{"label":"查找办事事项","status":"success","step":1,"tool":"search_service"},{"label":"检索官方资料","status":"success","step":2,"tool":"search_knowledge"}],"result_status":"success","service_links":[{"availability":"not_checked","checked_at":"2026-10-14","id":"service-link:3ec726871781d47685e3","kind":"guide","network_requirement":"unknown","requires_login":null,"source_id":"cdut:source:official:portal-1053","source_title":"网络故障报修","source_url":"https://bsdt.cdut.edu.cn/EIP/nonlogin/elobby/service/introduction/4hjbbewp5kip6nh5r5pstwccmdf4fssg.htm","title":"网络故障报修","url":"https://bsdt.cdut.edu.cn/EIP/nonlogin/elobby/service/introduction/4hjbbewp5kip6nh5r5pstwccmdf4fssg.htm"}],"services":[{"academic_year":null,"aliases":[],"audience":"研究生,学校管理员,教师,学生","availability":null,"contacts":[{"label":"咨询电话","value":".028-84079467"}],"department":"网络与信息化处","entry_points":["砚湖易办事项指南「网络故障报修」（编号 1053）","https://bsdt.cdut.edu.cn/EIP/nonlogin/elobby/service/introduction/