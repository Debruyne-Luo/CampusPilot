# Merge into /etc/campuspilot/campuspilot.env (mode 0600, owner root). Never commit real values.
CAMPUSPILOT_DATA_DIR=/opt/campuspilot/current/data/cdut
CAMPUSPILOT_RUNTIME_MODE=phase2
CAMPUSPILOT_AGENT_LOOP=on
CAMPUSPILOT_MODEL_BASE_URL=https://api.deepseek.com
CAMPUSPILOT_MODEL=deepseek-flash
CAMPUSPILOT_MODEL_MAX_TOKENS=1500
CAMPUSPILOT_MODEL_API_KEY=REPLACE_ME
CAMPUSPILOT_MODEL_KEY_FILE=
CF_ACCOUNT_ID=REPLACE_ME
CF_API_TOKEN=REPLACE_ME
AMAP_JS_KEY=REPLACE_ME
AMAP_SECURITY_JS_CODE=REPLACE_ME
CAMPUSPILOT_RETRIEVAL_MODE=lexical
# The --knowledge-current release carries current.json and its recovery version.
CAMPUSPILOT_KNOWLEDGE_BUNDLE=
# v2 assets served under /assets/v-<content hash>/ with immutable caching
CAMPUSPILOT_ASSET_VERSION=auto

# Do not activate without credential/price configuration and validation; see handoff.
CAMPUSPILOT_AMAP_DISCOVERY=off
AMAP_WEB_SERVICE_KEY=
CAMPUSPILOT_IMAGES=off
# Optional independent vision reader. Enable images only after configuring and testing it.
CAMPUSPILOT_READER=
CAMPUSPILOT_READER_BASE_URL=
CAMPUSPILOT_READER_KEY_FILE=
CAMPUSPILOT_READER_TIMEOUT=40
CAMPUSPILOT_READER_MAX_TOKENS=2000
CAMPUSPILOT_WEB_SEARCH=on
CAMPUSPILOT_WEB_SEARCH_PROVIDER=deepseek
CAMPUSPILOT_EVIDENCE_BUDGET_DIR=/var/lib/campuspilot/evidence-budget
CAMPUSPILOT_EVIDENCE_DAILY_USD=1
CAMPUSPILOT_EVIDENCE_DAILY_FLOWS=100
CAMPUSPILOT_SEARCH_INPUT_USD_PER_M=
CAMPUSPILOT_SEARCH_OUTPUT_USD_PER_M=
CAMPUSPILOT_JEV=on
CAMPUSPILOT_JEV_ROUTING=on
CAMPUSPILOT_HARNESS_PROFILE=
CAMPUSPILOT_LAB_RECORDS_DIR=
CAMPUSPILOT_JEV_BUDGET_DIR=/var/lib/campuspilot/jev-budget
CAMPUSPILOT_JEV_DAILY_USD=1
CAMPUSPILOT_JEV_DAILY_CALLS=2000
CAMPUSPILOT_JEV_KEY_FILE=
CAMPUSPILOT_JEV_INPUT_USD_PER_MILLION=
CAMPUSPILOT_JEV_OUTPUT_USD_PER_MILLION=
TAVILY_API_KEY=
TAVILY_FREE_PLAN_CONFIRMED=false
