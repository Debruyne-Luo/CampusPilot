# Dedicated hostname only. Replace example.invalid before nginx -t and reload.
server {
    listen 80;
    server_name campuspilot.example.invalid;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        proxy_pass http://127.0.0.1:18880;
        proxy_set_header Host $host;
    }
    location / {
        return 404;
    }
}
