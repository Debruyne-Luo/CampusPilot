# Unit for the release layout (/opt/campuspilot/current -> releases/<version>, shared venv).
# Replaces campuspilot.service at cutover; see docs/DEPLOY_RELEASE.zh-CN.md.
[Unit]
Description=CampusPilot read-only campus assistant (release layout)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campuspilot
Group=campuspilot
WorkingDirectory=/opt/campuspilot/current
EnvironmentFile=/etc/campuspilot/campuspilot.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/campuspilot/current/backend/src
ExecStart=/opt/campuspilot/venv/bin/python -m uvicorn campuspilot.web:app_factory --factory --host 127.0.0.1 --port 8766 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
UMask=0077
MemoryMax=450M
TasksMax=64
StandardOutput=journal
StandardError=journal
SyslogIdentifier=campuspilot

[Install]
WantedBy=multi-user.target
