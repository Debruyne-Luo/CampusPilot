# Release-layout site block: same auth/logging policy as Caddyfile.campuspilot plus CDN-friendly
# caching. Content-addressed v2 assets (/assets/v-<hash>/...) are immutable; everything else
# revalidates; API responses are never cached. Access logs stay disabled.
{$CAMPUSPILOT_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 16KB
    }
    @versioned path /assets/v-*
    header @versioned Cache-Control "public, max-age=31536000, immutable"
    @assets path /assets/* /static/*
    header @assets ?Cache-Control "public, max-age=0, must-revalidate"
    @api path /api/* /_AMapService/*
    header @api Cache-Control "no-store"
    @shell path / /classic /map-view
    header @shell Cache-Control "no-cache"
    @public_tools path /v1/* /healthz
    handle @public_tools {
        reverse_proxy 127.0.0.1:8766
    }
    handle {
        basic_auth {
            {$CAMPUSPILOT_VISITOR_USER} {$CAMPUSPILOT_VISITOR_HASH}
        }
        reverse_proxy 127.0.0.1:8766
    }
}
