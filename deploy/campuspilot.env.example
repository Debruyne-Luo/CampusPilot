# Template only. Actual file: /etc/campuspilot/campuspilot.env, mode 0600, outside checkout.
# Replace placeholders locally. Never commit the filled file.
PUBLIC_ORIGIN=https://YOUR_DOMAIN
CAMPUSPILOT_DATA_DIR=/opt/campuspilot/current/data/cdut
CAMPUSPILOT_API_TOKEN=REPLACE_WITH_RANDOM_TOOL_TOKEN_AT_LEAST_32_ASCII_CHARACTERS
CAMPUSPILOT_DAILY_CHAT_LIMIT=100
# Migration defaults to legacy until independent stage release gates pass.
CAMPUSPILOT_RUNTIME_MODE=legacy
CAMPUSPILOT_MODEL_BASE_URL=
CAMPUSPILOT_MODEL=
# Keep the real key outside checkout. Use either API_KEY or KEY_FILE, never both.
CAMPUSPILOT_MODEL_KEY_FILE=
CAMPUSPILOT_DIRECT_RULES_REPORT=
# Jev, Dify dataset credentials and pricing are maintenance-only in migration.ps1.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
# Enable only after importing/publishing the structured workflow candidate.
DIFY_STRUCTURED_ANSWERS=0
# Browser JS key is public; security code is used only by the backend proxy.
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
